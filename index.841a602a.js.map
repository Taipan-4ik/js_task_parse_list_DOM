"use strict";
var list = document.querySelectorAll("li");
function sortList() {
    var employees = [];
    list.forEach(function(person) {
        var salary = parseFloat(person.getAttribute("data-salary"));
        employees.push({
            name: person.innerText,
            position: person.getAttribute("data-position"),
            salary: salary,
            age: person.getAttribute("data-age"),
            element: person
        });
    });
    employees.sort(function(a, b) {
        return b.salary - a.salary;
    });
    employees.forEach(function(human) {
        document.querySelector("ul").appendChild(human.element);
    });
}
function getEmployees() {
    var employeesArray = [];
    list.forEach(function(person) {
        employeesArray.push({
            name: person.innerText,
            position: person.getAttribute("data-position"),
            salary: parseFloat(person.getAttribute("data-salary")),
            age: person.getAttribute("data-age")
        });
    });
    return employeesArray;
}
sortList();
getEmployees();

